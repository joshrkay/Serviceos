{
  "name": "@serviceos/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "//": "Isolated Expo project — intentionally NOT a root npm workspace. The root Dockerfile runs `npm ci` over packages/api|web|shared only; adding mobile to the root workspaces would either break that `npm ci` (missing workspace in the image) or pull the Expo/RN tree into the api image. Metro resolves @ai-service-os/shared from ../shared/src (see metro.config.js).",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "test": "vitest run",
    "test:rn": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "validate:config": "node ./scripts/validate-mobile-config.mjs",
    "export:web": "expo export --platform web --output-dir .e2e-web",
    "e2e:viewport": "EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL:-http://api.e2e.invalid} EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=${EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY:-pk_test_Y2xlcmsuZTJlLmludmFsaWQk} npm run export:web -- --clear && playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@clerk/expo": "^4.14.0",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo/metro-runtime": "~57.0.17",
    "@react-native-community/netinfo": "12.0.1",
    "@stripe/stripe-terminal-react-native": "^0.0.1-beta.31",
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.22",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "nativewind": "4.2.7",
    "query-string": "9.5.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.2.4",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vitest": "4.1.11"
  }
}
