# Absolute base URL of the ServiceOS API (the RN app is not same-origin).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Clerk publishable key for @clerk/clerk-expo (wired in U2).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# DEV/TEST ONLY — never set in a store build (refused for any EAS profile other
# than `development` and for NODE_ENV=production; see scripts/dev-auth-guard.cjs).
# `dev` swaps Clerk for src/dev/clerk-expo-dev-shim.tsx so the app signs in
# against an API running with DEV_AUTH_BYPASS=true (Maestro device harness).
# EXPO_PUBLIC_AUTH_MODE=dev
