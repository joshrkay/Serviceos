# API
PORT=3000
NODE_ENV=development
# Clerk — use the Development instance (pk_test_ / sk_test_).
# BOTH web and API must use the SAME instance. Also create the JWT template
# named exactly "serviceos" with tenant_id + role claims from public_metadata.
# Full checklist: docs/runbooks/clerk-setup.md
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Hermetic local only (unsigned tokens). Never set in staging/prod.
# DEV_AUTH_BYPASS=true
# Pair with web VITE_AUTH_MODE=dev when using the Clerk shim.

# Database — Railway provides DATABASE_URL automatically when Postgres is linked.
# For local dev, use individual vars instead.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=serviceos_dev
DB_USER=serviceos
DB_PASSWORD=
DB_SSL=false
DB_MAX_CONNECTIONS=20

# CORS — set to the web frontend URL
CORS_ORIGIN=http://localhost:5173

# Web (build-time, set as Railway build arg)
VITE_API_URL=http://localhost:3000
# Same publishable key as CLERK_PUBLISHABLE_KEY above (pk_test_ for local).
# Requires Clerk JWT template "serviceos" — see docs/runbooks/clerk-setup.md
VITE_CLERK_PUBLISHABLE_KEY=
# Hermetic local/CI only — aliases @clerk/clerk-react to the dev shim.
# VITE_AUTH_MODE=dev
# Customer invoice payment page — Stripe Elements publishable key (pk_live_... or pk_test_...)
VITE_STRIPE_PUBLISHABLE_KEY=
# §10 onboarding v2 — sidebar shell + derived status + app-shell guard.
# Local dev / E2E: true (6-step checklist). Set false for legacy 9-step wizard.
# Production (Railway @serviceos/web): set VITE_ONBOARDING_V2_ENABLED=true
# as a service variable (rendered into /env.js at container start — no
# rebuild required). Mirror on Vercel preview if used.
VITE_ONBOARDING_V2_ENABLED=true

# §10 onboarding — Stripe subscription price for the 14-day trial.
# Required when VITE_ONBOARDING_V2_ENABLED=true and Stripe Checkout
# is in use. Format: price_<...>
STRIPE_PRICE_ID=

# §10 onboarding — base URL the API embeds in Stripe success/cancel
# URLs and the upgrade-nudge email. Defaults to http://localhost:5173.
WEB_URL=http://localhost:5173

# §10 onboarding — trial voice cap overrides (integers). Leave unset
# in production; useful for QA where you want to exercise the
# voicemail-on-cap path without burning 60 minutes of calls.
TRIAL_VOICE_MINUTES_DAILY_OVERRIDE=
TRIAL_VOICE_MINUTES_TOTAL_OVERRIDE=

# AI provider — host and model IDs must match (Claude/Llama on OpenAI fails
# every completion). Full Railway profiles: docs/runbooks/live-ai-restore.md
# Profile A (OpenAI): AI_PROVIDER_BASE_URL=https://api.openai.com/v1 + gpt-* tiers
# Profile B (OpenRouter): AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1 + Llama/Qwen
# Also see packages/api/.env.example and npm run check:ai-provider-config
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_BASE_URL=
# AI_LIGHTWEIGHT_MODEL=
# AI_STANDARD_MODEL=
# AI_COMPLEX_MODEL=

# Payments (API)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Webhooks
CLERK_WEBHOOK_SECRET=

# Monitoring
SENTRY_DSN=

# Prometheus /metrics bearer token. Optional in dev (route allows
# unauthenticated scrapes when unset); REQUIRED in prod/staging — without
# it the endpoint refuses with 503 so tenant ids and traffic counters
# can't be enumerated from outside.
METRICS_TOKEN=

# ─── Solo owner launch (voice) ───────────────────────────────────────────
# Production: set TWILIO_MEDIA_STREAMS_ENABLED=true for Media Streams path.
# TWILIO_MEDIA_STREAMS_ENABLED=false
# After soak: TTS_PROVIDER=elevenlabs (default openai for local dev).
# TTS_PROVIDER=openai
# ELEVENLABS_API_KEY=          # Streaming TTS when TTS_PROVIDER=elevenlabs
# DEEPGRAM_API_KEY=            # Streaming STT + keyword boost for inbound voice
# DATABASE_URL is required in prod (no in-memory proposal store).
# Raw voice-transcript retention is encrypted at rest (AES-256-GCM). Set a
# dedicated 64-hex (32-byte) key, or it falls back to TENANT_ENCRYPTION_KEY.
# When neither is set, raw transcripts are NOT retained (no plaintext at rest).
# TRANSCRIPT_ENCRYPTION_KEY=
# TENANT_ENCRYPTION_KEY=          # Fallback for transcript encryption if TRANSCRIPT_ENCRYPTION_KEY unset

# ─── E2E / Playwright (Clerk testing tokens) ─────────────────────────────
# Required to run the journey specs that exercise real Clerk signup/login.
# Get these from the SAME Clerk dev instance you use for VITE_CLERK_PUBLISHABLE_KEY
# above, with "Testing mode" enabled in the Clerk dashboard.
# See qa/reports/2026-05-11/clerk-testing-tokens-runbook.md for the runbook.
E2E_CLERK_PUBLISHABLE_KEY=
E2E_CLERK_SECRET_KEY=

# ─── Google Calendar OAuth (Tier 4 calendar sync) ────────────────────────
# Read by app.ts to build `googleConfig`. BOTH must be non-empty or the
# whole integration is disabled and /api/calendar-integrations/google/connect
# returns 400 "Google calendar integration is not configured".
# NOTE the GOOGLE_OAUTH_ prefix — not GOOGLE_CLIENT_ID.
# Create at: Google Cloud console → APIs & Services → Credentials →
#   OAuth client ID → Web application. Enable the Google Calendar API.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The redirect URI is NOT configurable — it is derived as
#   `${PUBLIC_API_URL}/api/calendar-integrations/google/callback`
# Register that exact string in the Google console. PUBLIC_API_URL must have
# NO trailing slash (there is no normalisation) or Google rejects the callback
# with redirect_uri_mismatch. Scopes are hardcoded in
# integrations/google-calendar.ts: calendar.events, calendar.readonly,
# userinfo.email. TENANT_ENCRYPTION_KEY is REQUIRED — without it the OAuth
# callback throws AFTER consuming the one-time state nonce, so every retry
# fails too.

# ─── Object storage (Cloudflare R2) ──────────────────────────────────────
# Required when STORAGE_ENABLED is not 'false'. Validated in shared/config.ts.
# These are the names the validator reads — STORAGE_ACCESS_KEY_ID /
# STORAGE_SECRET_ACCESS_KEY are NOT read by anything and setting them has
# no effect.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL is optional — S3StorageProvider falls back to presigned GETs.
STORAGE_ENABLED=false

# ─── Email delivery ──────────────────────────────────────────────────────
# When EMAIL_ENABLED is not 'false', ONE of the two backends below must be
# fully configured (shared/config.ts errors at boot only if NEITHER is).
#
# 1) Twilio-native email (comms.twilio.com/v1/Emails) — PREFERRED when the
#    account already sends via Twilio. Reuses TWILIO_ACCOUNT_SID +
#    TWILIO_AUTH_TOKEN below, so this is the ONLY var needed. The address
#    must belong to an APPROVED Verified Sender domain in the Twilio console
#    or every send 400s/401s.
# TWILIO_EMAIL_FROM_ADDRESS=
# TWILIO_EMAIL_FROM_NAME=      # optional display name; ASCII only
#
# 2) SendGrid (separate product, separate `SG.`-prefixed key).
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
#
# If BOTH are configured, Twilio-native wins and app.ts logs the choice.
EMAIL_ENABLED=false

# ─── Telephony master switches ───────────────────────────────────────────
# TELEPHONY_ENABLED=false forces the estimate/invoice delivery providers to
# NOOP — nothing is actually sent to customers. When true, these are required:
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER,
#   TWILIO_DEFAULT_TENANT_ID
# The webhook signature middleware returns 500 (fail-closed, deliberate) when
# TWILIO_AUTH_TOKEN is unset — a 500 on /api/telephony/voice means "missing
# credentials", not a code bug.
TELEPHONY_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_DEFAULT_TENANT_ID=
# Media Streams (bidirectional audio) is OPT-IN and requires a raw-PCM TTS
# path: TTS_PROVIDER=elevenlabs + ELEVENLABS_API_KEY. OpenAI tts-1 returns
# mp3, which the PCM16→mu-law encoder plays as inaudible static (VOX-30).
TWILIO_MEDIA_STREAMS_ENABLED=false
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# DEEPGRAM_API_KEY=

# ─── Row-level security (HARD prod/staging requirement, no opt-out) ──────
# Postgres RLS is a runtime NO-OP unless the app drops to the least-privilege
# rls_app_runtime role. Requires migration 217 to have provisioned that role.
RLS_RUNTIME_ROLE=true
