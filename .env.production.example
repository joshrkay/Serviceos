# ─────────────────────────────────────────────────────────────────────────
# Rivet (ServiceOS) — PRODUCTION environment template
#
# Launch-critical subset of variables, organized by failure tier. For the
# exhaustive list (dev defaults, QA/E2E, advisory voice vars) see .env.example
# and docs/prod-env-checklist.md. Set these as Railway service variables on the
# API service (and the VITE_* block as build-time vars on the web service).
#
# DO NOT commit real secret values. This file is a template only.
# Procedure: docs/launch/GO-LIVE-RUNBOOK.md
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ═══ TIER 0 — BOOT-FAIL ═══════════════════════════════════════════════════
# Missing any of these → the API process refuses to start in production
# (validateProductionConfig, packages/api/src/shared/config.ts; the Stripe key
# is enforced by createPaymentLinkProvider at boot, app.ts:966).

# Railway injects DATABASE_URL automatically when a Postgres plugin is linked.
# Scaling to many replicas: point DATABASE_URL at PgBouncer (transaction mode)
# so N app pools multiplex onto a bounded Postgres max_connections. The request
# hot path is transaction-pooling-safe (SET LOCAL tenant context). See
# docs/runbooks/scaling.md.
DATABASE_URL=
# Provider CA certificate (PEM) for Postgres TLS. When set, every pool verifies
# the server certificate (audit T4-F13). Unset = encrypted but unverified, as
# before, with a one-line boot warning. Railway: paste the CA with \n escapes.
# DB_SSL_CA=

# DIRECT (session-mode) Postgres DSN that BYPASSES PgBouncer. Required ONLY when
# DATABASE_URL points at PgBouncer: session-scoped state — leader-election
# advisory locks, the proposal idempotency lock, and LISTEN/NOTIFY — must hold a
# stable backend and breaks under transaction pooling. Leave UNSET when not
# using PgBouncer; the app then reuses DATABASE_URL for those (identical to
# single-instance behavior). createDirectPool(), packages/api/src/db/pool.ts.
# NOTE: pre-deploy migrations (railway.toml preDeployCommand -> migrate.js) run
# through this DIRECT DSN when set — DDL + session SET lock_timeout/statement_timeout
# must NOT go through transaction-mode PgBouncer. Falls back to DATABASE_URL when unset.
DATABASE_DIRECT_URL=

# Per-replica app pool size. Rule of thumb: max ≈ vCPU * 4 (bounded by expected
# concurrent OPEN transactions per replica — keep request transactions short so
# PgBouncer multiplexes). Across N replicas this is the PgBouncer client side;
# PgBouncer's server pool (DEFAULT_POOL_SIZE) is what bounds real Postgres
# connections. Watch the db_pool_connections{state="waiting"} metric.
DB_MAX_CONNECTIONS=20
# Small pool for the direct (session) DSN — only the lock holders + LISTEN use it.
DB_DIRECT_MAX_CONNECTIONS=10

# Redis — shared state across replicas. UNSET = single-instance (every shared
# store falls back to its in-memory implementation, byte-identical to today).
# Set this before running > 1 replica so WS connection caps are cluster-wide and
# voice events fan out across replicas. See docs/runbooks/scaling.md.
REDIS_URL=
# Mirror live voice events across replicas over Redis pub/sub so the supervisor
# wall and client WS gateway can observe calls owned by another replica. Requires
# REDIS_URL too; dark-launch switch — leave 'false' until > 1 replica.
VOICE_FANOUT_ENABLED=false

# Queue throughput (P3): messages claimed + processed concurrently per 250ms poll
# tick (FOR UPDATE SKIP LOCKED keeps it multi-replica-safe). Raise to lift the
# per-process rate; total throughput also scales with replica count.
QUEUE_POLL_BATCH_SIZE=10
# Per-tenant /api request cap per minute (P3), enforced cluster-wide when
# REDIS_URL is set (else per-process). Coarse per-IP DoS limits are separate and
# always on. Sized so one tenant's dashboards/integrations can't starve a replica.
API_TENANT_RATE_LIMIT_MAX=1000
# T4-F02 — /api per-IP request cap per 15min window; a DoS guard, NOT the
# fairness control (API_TENANT_RATE_LIMIT_MAX above is). Default 2000 avoids
# starving a shared-NAT office's normal multi-user traffic; tighten if abuse
# patterns emerge.
API_IP_RATE_LIMIT_MAX=2000
# T4-F02 — /webhooks/{stripe,clerk,vapi,twilio,wisetack,sendgrid} request cap
# per minute, mounted before the general /webhooks limiter (30/min) so
# legitimate provider callback bursts aren't 429'd ahead of signature
# verification. Unknown/junk /webhooks/* paths stay on the 30/min limit.
WEBHOOK_PROVIDER_RATE_LIMIT_MAX=600

# Clerk → API keys (Production instance → API Keys). Must be pk_live_ / sk_live_
# (validateEnvSchema refuses test keys unless ALLOW_CLERK_TEST_KEYS=true).
# Also create JWT template "serviceos" on this instance — without it the web
# client cannot mint API tokens. See docs/runbooks/clerk-setup.md.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Comma-separated frontend origins whose Clerk session tokens this API accepts
# (the token's `azp` claim), e.g. https://app.therivetapp.com. Unset = any azp.
# CLERK_AUTHORIZED_PARTIES=
# ALLOW_CLERK_TEST_KEYS=true   # staging-only escape hatch for pk_test_/sk_test_

# Clerk webhook signing secret (Clerk dashboard → Webhooks → your endpoint →
# Signing Secret). Pairs with the POST /webhooks/clerk endpoint. Missing → the
# Clerk user.created webhook 500s and tenants are never bootstrapped.
# Webhook must also PATCH public_metadata { tenant_id, role } (handler does this).
CLERK_WEBHOOK_SECRET=

# LLM gateway (OpenAI-compatible). Without AI_PROVIDER_API_KEY the ENTIRE AI
# pipeline is an inert mock (intent classification returns "unknown").
# Host + model IDs must match — see docs/runbooks/live-ai-restore.md
# Static check: cd packages/api && npm run check:ai-provider-config
#
# Profile B (recommended go-live) — OpenRouter managed open models:
# docs/runbooks/openrouter-ai-provider.md
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
AI_LIGHTWEIGHT_MODEL=meta-llama/llama-3.1-8b-instruct
AI_STANDARD_MODEL=meta-llama/llama-3.3-70b-instruct
AI_COMPLEX_MODEL=qwen/qwen2.5-vl-72b-instruct
#
# Profile A (immediate) — OpenAI direct when the key is already sk-… OpenAI.
# Unset the Llama/Qwen tier vars above when using this block:
# AI_PROVIDER_API_KEY=sk-...
# AI_PROVIDER_BASE_URL=https://api.openai.com/v1
# AI_DEFAULT_MODEL=gpt-4o-mini
# AI_LIGHTWEIGHT_MODEL=gpt-4o-mini
# AI_STANDARD_MODEL=gpt-4o-mini
# AI_COMPLEX_MODEL=gpt-4o
# OpenAI models are deliberately unpriced by default (GATEWAY-04), so with
# Profile A set their prices here (integer cents per 1M tokens, OpenAI list
# price). Without it every ai_runs row stores cost_micro_cents NULL, the
# failure monitor's ai_spend_window rule cannot see spend, and its
# ai_spend_unpriced warning keeps paging (docs/runbooks/failure-rate-monitor.md).
# AI_MODEL_PRICING_JSON={"gpt-4o-mini":{"inputCentsPerMillionTokens":15,"outputCentsPerMillionTokens":60},"gpt-4o":{"inputCentsPerMillionTokens":250,"outputCentsPerMillionTokens":1000}}
# Voice classifier's independent end-to-end budget. Empty string falls back to
# the 4s code default — keep this set (prod tuned: 12000). Never leave blank.
# AI_CLASSIFY_INTENT_DEADLINE_MS=12000
#
# Dual-provider failover (FM-03): keep Profile A as PRIMARY; add OpenRouter as
# FALLBACK only. Both key + URL required. Not the same as Profile B primary swap.
# AI_FALLBACK_PROVIDER_API_KEY=sk-or-...
# AI_FALLBACK_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
# AI_FALLBACK_LIGHTWEIGHT_MODEL=meta-llama/llama-3.1-8b-instruct
# AI_FALLBACK_STANDARD_MODEL=meta-llama/llama-3.3-70b-instruct
# AI_FALLBACK_COMPLEX_MODEL=qwen/qwen2.5-vl-72b-instruct
# Failover shares the request's ONE deadline: a hanging primary is cut off up
# to this many ms early (never more than 1/4 of the budget) so the fallback
# still gets a try. 0 = the primary keeps the whole budget.
# AI_FALLBACK_RESERVE_MS=2500
#
# Per-tenant AI quota tiers, merged over the built-in table in
# ai/gateway/tenant-quota.ts (no deploy needed to resize). Every tenant's voice
# + in-app intent classification runs on classifier_standard. A built-in tier
# may override any of maxConcurrency / bucketCapacity / refillTokensPerSec /
# hardUpperBoundTokens; a new tier needs all four. INVALID JSON FAILS BOOT.
# AI_QUOTA_TIERS_JSON={"classifier_standard":{"maxConcurrency":8}}

# Exact web origin (no wildcard). Must match the deployed web URL.
CORS_ORIGIN=https://app.yourdomain.com

# Stripe secret key (sk_live_...). Gates billingService + Connect + payment
# links; createPaymentLinkProvider throws at boot in prod if unset.
STRIPE_SECRET_KEY=

# Postgres Row-Level Security enforcement (SEC-01). REQUIRED in prod/staging —
# validateFeatureRequiredConfig (packages/api/src/shared/config.ts) refuses to
# boot without it set to the literal 'true'. When on, every tenant-scoped query
# drops to the least-privilege, RLS-subject rls_app_runtime role, so the
# tenant-isolation policies actually enforce (a forgotten tenant_id filter can no
# longer cross tenants). REQUIRES the rls_app_runtime role from migration 217 to
# be provisioned + granted to the app's DB user; the boot probe
# (verifyRlsRuntimeRole) fails fast if it is not. On managed Postgres where the
# app user lacks CREATEROLE, provision the role via the admin SQL in the runbook
# BEFORE the first prod/staging deploy. Procedure:
# docs/runbooks/rls-runtime-role-rollout.md.
RLS_RUNTIME_ROLE=true

# ═══ TIER 1 — SIGNUP → 14-DAY TRIAL → PAID ════════════════════════════════
# The commercial loop. Boots without these, but the loop silently 503s.

# Recurring price for the trial subscription (Stripe → Products → your plan →
# Price ID, price_...). Deprecated: provisioning script compatibility only;
# web onboarding requires the two explicit per-plan variables below.
STRIPE_PRICE_ID=

# Per-plan recurring prices for the Starter ($79) / Growth ($199) onboarding
# selection (Stripe → Products → each plan → Price ID, price_...). Each is
# validated live against Stripe before checkout; live and sandbox IDs must
# differ. invoice.created maps the invoice's subscription price to a plan
# to settle AI-minute overage. See docs/plans/per-call-pricing.md.
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=

# Stripe webhook signing secret(s) (Stripe dashboard → Developers → Webhooks →
# your endpoint → Signing secret, whsec_...). Pairs with POST /webhooks/stripe.
# Missing → boot-fails in prod/staging (SEC-43, validateProductionConfig); with
# it unset the trial→paid conversion could never land anyway (trialing state is
# written ONLY by customer.subscription.created).
# Full Stripe Connect coverage needs TWO endpoints (platform + connected
# accounts), each with its own secret — set BOTH here as a comma-separated list
# (whsec_platform,whsec_connected). A single value works for a single endpoint.
# See docs/runbooks/stripe-go-live.md.
STRIPE_WEBHOOK_SECRET=

# Public origins — resolved once at boot into config.publicOrigins. Both are
# REQUIRED in prod/staging, must be https, must be bare origins (no path), and
# must differ from each other: when they collide every emailed / texted link
# is built on the API host.
#   WEB_URL         where humans open the SPA: Stripe return, invitations,
#                   lifecycle-email CTAs, OAuth return, /e /pay /feedback links.
#   PUBLIC_API_URL  where machines call this API back: Twilio webhooks and
#                   signature checks, media-stream socket, OAuth redirect_uri.
#   APP_PUBLIC_URL  DEPRECATED alias for WEB_URL (boot warning; never the API).
WEB_URL=https://app.yourdomain.com
PUBLIC_API_URL=https://api.yourdomain.com
# Standalone marketing site (signed-out app-root redirects). Defaults to
# https://therivetapp.com; only override for a preview marketing site.
# MARKETING_SITE_URL=https://therivetapp.com

# HMAC secret for the single-use one-tap approve links in owner SMS (digest
# "APPROVE"/"Invoice it" links and unsupervised queue_and_sms). In prod/staging
# there is NO fallback: when unset the links are SILENTLY OMITTED from digests
# rather than failing loudly (app.ts one-tap wiring). Generate: openssl rand -hex 32.
ONE_TAP_APPROVE_SECRET=

# Optional: Stripe Billing Portal configuration id for the manage-subscription
# portal (Stripe → Billing → Customer portal). Stripe default used if unset.
# STRIPE_BILLING_PORTAL_CONFIGURATION=

# ═══ TIER 2 — FEATURE CREDENTIALS (required unless the feature is disabled) ═
# Telephony (inbound AI voice + SMS). Omit only with TELEPHONY_ENABLED=false.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_DEFAULT_TENANT_ID=
# #1564 — US A2P 10DLC registration (Rivet as ISV, fees absorbed). Rivet's
# Twilio-APPROVED Primary Business Profile SID (TrustHub, parent account) and
# the ISV-owned inbox for TrustHub status emails. Unset → owner submissions are
# stored and the registration worker waits and re-polls; nothing is sent.
TWILIO_A2P_PRIMARY_PROFILE_SID=
TWILIO_A2P_NOTIFICATION_EMAIL=
# #1402 §18 — per-recipient SMS volume cap: at most N customer texts to one
# number per tenant in a rolling window (owner-class sends, incl. E1 emergency
# pages, are never capped). 0 disables the cap.
# SMS_RECIPIENT_CAP_PER_WINDOW=20
# SMS_RECIPIENT_CAP_WINDOW_HOURS=24
# Voice Media Streams (bidirectional live audio). THREE states (WS7):
#   false      → kill switch: every call uses Gather, full stop.
#   true       → forced on; boot REQUIRES TTS_PROVIDER=elevenlabs +
#                ELEVENLABS_API_KEY (enforced in shared/config.ts) because the
#                media-streams path needs raw PCM — the default OpenAI TTS
#                returns mp3 that plays as inaudible static (VOX-30).
#   unset/auto → on ONLY when the full stack is present: TTS_PROVIDER=elevenlabs
#                AND ELEVENLABS_API_KEY AND DEEPGRAM_API_KEY (all three). A
#                partial stack stays on Gather; auto never boot-crashes.
# Production default is 'auto' (D-043): realtime is on when the ElevenLabs +
# Deepgram stack is fully configured, off on any partial stack. 'false' is the
# kill switch; Gather is the degrade path for every failure. Ramp and rollback:
# docs/runbooks/voice-realtime-rollout.md.
# DEEPGRAM_API_KEY (STT) is required for any working stream. Railway does NOT
# read this file — set these in the API service's Variables.
TWILIO_MEDIA_STREAMS_ENABLED=auto
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
# REQUIRED when telephony is enabled. Customer AI-voice overage settlement
# fails closed unless every provider's contracted cost can be attributed.
# Values are cents and may be decimal; use the rates on the current contracts.
DEEPGRAM_COST_CENTS_PER_HOUR=
ELEVENLABS_COST_CENTS_PER_1000_CHARS=
TWILIO_MEDIA_STREAMS_COST_CENTS_PER_HOUR=
# Email delivery (estimates/invoices). Omit BOTH backends only with
# EMAIL_ENABLED=false — boot fails only when NEITHER is complete.
#
# Backend 1 (PREFERRED here — this account sends through Twilio, not
# SendGrid): Twilio-native email, POST comms.twilio.com/v1/Emails. It reuses
# TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN above, so TWILIO_EMAIL_FROM_ADDRESS
# is the only new variable — NO new credential. PREREQUISITE outside this
# file: the address's domain must be an APPROVED Verified Sender in the
# Twilio console. Without it, sends fail 400/401 with correct code.
# TWILIO_EMAIL_FROM_NAME is an optional display name (ASCII only — Twilio
# rejects Unicode in the `from` field).
TWILIO_EMAIL_FROM_ADDRESS=
TWILIO_EMAIL_FROM_NAME=
#
# Backend 2: SendGrid — a DIFFERENT product with its own `SG.`-prefixed key.
# Leave blank when using Twilio-native email above. If both are complete,
# Twilio-native wins and the choice is logged at boot.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Object storage — call recordings, customer uploads, inbound MMS photos.
# ONE contract: shared/storage-config.ts resolves it, and BOTH the boot
# validator and the storage factory call that resolver, so they cannot
# disagree. Any S3-compatible store works; for Cloudflare R2 use the account
# S3 endpoint https://<account-id>.r2.cloudflarestorage.com with region auto.
# Omit ONLY with STORAGE_ENABLED=false — uploads, recordings and MMS photos
# are then NOT persisted (a boot-time WARN says so).
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Optional download base URL (unset = presigned GET URLs).
# STORAGE_PUBLIC_URL=
# Cloudflare R2 alias — the pre-existing documented names, still accepted. Each
# is used only where its STORAGE_* counterpart is unset: endpoint becomes
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com, region auto, bucket
# R2_BUCKET (default serviceos-uploads). Not consulted under STORAGE_ENABLED=false.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=serviceos-uploads
# Shared Google OAuth client (Google Cloud Console → Credentials → OAuth 2.0
# Client ID, type "Web application"). Powers BOTH self-serve connect flows:
#   - per-user Google Calendar sync   (/api/calendar-integrations)
#   - per-tenant Google Business reviews (/api/googlebusiness-integrations —
#     review polling + AI-drafted replies behind human approval)
# Register BOTH redirect URIs on the client:
#   <PUBLIC_API_URL>/api/calendar-integrations/google/callback
#   <PUBLIC_API_URL>/api/googlebusiness-integrations/google/callback
# Unset → both "Connect" buttons return 400 "not configured"; already-connected
# Google Business tenants also lose token refresh, so review polling dies with
# a visible poll-state backoff ~1h after their last token was minted.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ═══ TIER 3 — RUNTIME SECURITY / OPS (boot OK, but insecure/broken if unset) ═
# /metrics refuses (503) in prod without this — prevents tenant-id enumeration.
METRICS_TOKEN=
# Error tracking (no-op without it).
SENTRY_DSN=
# U10 — Langfuse LLM trace export (no-op without BOTH keys; zero network
# calls). Every gateway completion — success, failure, cache hit — is exported
# as one trace (id = correlationId) grouped by voice session / chat
# conversation, with usage, cost, latency and prompt version. Prompt/reply
# CONTENT is never exported unless LANGFUSE_CAPTURE_CONTENT=true, and then
# only after redaction (voice traces carry caller transcripts). Point
# LANGFUSE_BASE_URL at a self-hosted instance if not using Langfuse Cloud.
# See docs/prod-env-checklist.md.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_CAPTURE_CONTENT=false
# T4-F06 — REQUIRED in prod/staging (validateFeatureRequiredConfig,
# packages/api/src/shared/config.ts): a 64-char hex string (32 bytes).
# Encrypts tenant integration credentials (integrations/credentials.ts),
# calendar tokens (calendar-integration.ts), accounting tokens
# (accounting/token-crypto.ts), and Twilio provisioning secrets
# (workers/provision-twilio.ts); also the fallback key for transcript-at-rest
# encryption when TRANSCRIPT_ENCRYPTION_KEY is unset. Missing or malformed →
# the app now refuses to boot (previously crashed on first decrypt/encrypt at
# runtime). Generate with: openssl rand -hex 32
TENANT_ENCRYPTION_KEY=
# Raw voice-transcript encryption at rest (64-hex / 32-byte, format-checked at
# boot when set — see validateFeatureRequiredConfig). Optional: falls back to
# TENANT_ENCRYPTION_KEY above; set this only to use a DIFFERENT key for
# transcripts than for tenant credentials.
# TRANSCRIPT_ENCRYPTION_KEY=
# D-015 amendment — platform-wide kill switch for the autonomous booking lane
# (UB-D). Optional; unset/'false' preserves per-tenant opt-in gating
# (tenant_settings.autonomous_booking_enabled). Set 'true' for incident
# response to disable the lane for every tenant at once without a per-tenant
# settings sweep.
# AUTONOMOUS_BOOKING_DISABLED=false
# D-018 → DEPRECATED by D-019 (QUALITY-2026-07-12 WS2). There is no longer any
# autonomous CLOSE execution — the on-call close only STAGES proposals for owner
# one-tap approval (nothing is system-approved or executed). Still accepted as a
# platform-wide off switch for even PREPARING that owner-approval chain, checked
# independently of AUTONOMOUS_BOOKING_DISABLED. Optional; unset/'false' is the
# default.
# AUTONOMOUS_CLOSE_DISABLED=false
# ANS-001 — mute switch for the Expo push fan-out on E1 life-safety alerts
# (app.ts wires the shared ExpoPushDeliveryProvider into the voice-turn
# processor only when this is not 'false'). Unset/'true' keeps E1 pushes on;
# set 'false' in dev/staging so an E1 test call doesn't POST to Expo's live
# endpoint. Does NOT gate the proposal/owner push notifiers.
# EXPO_PUSH_ENABLED=true
# WS15 — platform SLO monitor (workers/slo-monitor.ts; runbook
# docs/runbooks/slo-alerts.md). Evaluates every 5 min in worker/all roles and
# pages on breach: always a Sentry error event (needs SENTRY_DSN + the
# Sentry→Slack rules in docs/runbooks/alerting.md), plus an operator SMS when
# ALERT_SMS_TO is set. All knobs optional — the defaults shown are what apply
# when unset.
# Operator phone (E.164) for SLO breach SMS pages. Unset → Sentry-only.
# ALERT_SMS_TO=
# Min acceptable call completion rate over the trailing 60 min (0..1).
# SLO_CALL_COMPLETION_MIN=0.85
# Ended-call sample floor — below this many calls the completion rule never
# breaches (no 1-call false pages).
# SLO_CALL_COMPLETION_MIN_SAMPLE=5
# Pending queue jobs older than this many minutes are a breach (stuck queue).
# SLO_QUEUE_STALE_MIN=15
# Sweep-heartbeat age (minutes) above which the worker loop is presumed wedged.
# SLO_SWEEP_LAG_MIN=15
# WS26 — voice turn-latency P95 breach threshold (ms): media-streams STT-final →
# first TTS chunk. Only evaluated in-process under PROCESS_ROLE=all; split
# topologies alert via Prometheus (see docs/runbooks/slo-alerts.md).
# SLO_TURN_LATENCY_P95_MS=3500
# Min recorded turns before the turn-latency rule can breach (no early-boot pages).
# SLO_TURN_LATENCY_MIN_SAMPLE=30
# U1 (D-043) — reply gap (caller's last word → first reply frame Twilio acked)
# P95 breach threshold (ms); runs beside the turn-latency rule above.
# SLO_REPLY_GAP_P95_MS=1500
# Max share of replies that never played (enqueued, never acked), 0..1.
# SLO_REPLY_UNACKED_RATE_MAX=0.01
# Min recorded replies before either reply-gap rule can breach.
# SLO_REPLY_GAP_MIN_SAMPLE=30
# #1602 — min 7-day PRODUCTION graded pass rate (voice_session_grades, cross-
# tenant); default = the 85% Layer 2 launch gate CI enforces.
# SLO_VOICE_GRADED_PASS_MIN=0.85
# Graded-call sample floor before the pass-rate rule can breach.
# SLO_VOICE_GRADED_MIN_SAMPLE=10
# UTC hour of the nightly call-quality grading pass (08:00Z ≈ 1–4am US).
# VOICE_QUALITY_NIGHTLY_HOUR_UTC=8
# Per-rule re-page cooldown (minutes) for persistent breaches.
# SLO_ALERT_COOLDOWN_MIN=60
# U5 — absolute per-call wall-clock cap (ms) on both voice transports; the call
# is wrapped up and ended with terminal reason max_call_duration. 0/negative
# fails boot.
# VOICE_MAX_CALL_DURATION_MS=900000
# #1603 — per-USER cap on spoken clips per minute (POST /api/voice/tts and,
# S3-2, POST /api/voice/tts/batch draw from the same budget, one unit per clip
# actually synthesized; cache hits and GET /api/voice/tts/clip/:hash cost
# nothing). Every role holds ai:run and each clip bills the tenant's TTS key,
# so this is the brake on a scripted free-text TTS proxy. ai/tts/tts-clip-budget.ts.
# VOICE_TTS_PER_MIN=20
# S3-1 — byte budget of the per-process clip cache behind POST /api/voice/tts
# (clips keyed by voice + sha256 of the text; least-recently-used eviction).
# The onboarding lines are static per trade and voice, so a hit costs nothing.
# Default 64 MiB. ai/tts/clip-cache.ts.
# VOICE_TTS_CLIP_CACHE_BYTES=67108864

# FAIL-VIS — silent-failure monitor (workers/failure-rate-monitor.ts; runbook
# docs/runbooks/failure-rate-monitor.md). Evaluates every 10 min in worker/all
# roles and pages through the SAME channel as the SLO monitor above (Sentry
# always; operator SMS when ALERT_SMS_TO is set), reusing SLO_ALERT_COOLDOWN_MIN
# for repeat suppression. All knobs optional — the defaults shown are what apply
# when unset.
#
# Trailing window (minutes) for the ai_runs non-completion aggregate.
# FAILURE_MONITOR_WINDOW_MIN=30
# Settle offset (minutes) — runs newer than this are excluded from the window
# because they may still legitimately be in flight.
# FAILURE_MONITOR_SETTLE_MIN=5
# Non-completion rate (0..1) above which a task_type breaches. Healthy task
# types sit near 0; the July 2026 incidents were 0.85 and 1.00.
# FAILURE_MONITOR_RATE_MAX=0.25
# Volume floor — a task type with fewer runs than this in the window can never
# breach (1 failure in 2 calls is noise; 500 in 600 is a fire).
# FAILURE_MONITOR_MIN_RUNS=20
# Cap on task-failure pages per tick so a platform-wide outage cannot turn the
# monitor into its own alert storm. Everything breached is still logged.
# FAILURE_MONITOR_MAX_TASK_ALERTS=3
# Minutes a proposal may sit in `executing` before it counts as stalled.
# FAILURE_MONITOR_PROPOSAL_STALE_MIN=15
# Lookback (hours) for proposals that reached `execution_failed` with a NULL
# `execution_error` — a terminal failure state carrying no reason.
# FAILURE_MONITOR_PROPOSAL_LOOKBACK_HOURS=24
# OBS-4 — volume floor for the PER-TENANT non-completion rule
# (ai_task_failure_rate:<task>:<tenant>). Lower than FAILURE_MONITOR_MIN_RUNS:
# one tenant's volume is a fraction of the platform's, and the platform rule
# never sees a single tenant's outage once healthy tenants dilute it.
# FAILURE_MONITOR_TENANT_MIN_RUNS=10
# OBS-4 — platform-wide ai_runs spend (integer cents) over one window above
# which `ai_spend_window` pages. A loop that re-calls the model and COMPLETES
# every call never trips a failure-rate rule; only the bill moves. 0 = off.
# Default 200 cents per 30-minute window: about four tenants driven to their
# token-bucket ceiling on gpt-4o-mini. Raise it as the tenant count grows.
# FAILURE_MONITOR_SPEND_MAX_CENTS=200

# RIVET money findings — money-invariant reconciliation sweep
# (workers/money-reconciliation.ts). READ-ONLY detector that recomputes the
# invoice balance invariants (L2–L4) and the captured-vs-recorded Stripe
# checkout amounts (L5) per tenant and reports drift via logs, metrics
# (money_reconciliation_*_total), and audit events; it never repairs. Runs in
# worker/all roles behind its own advisory lock. Milliseconds between sweeps;
# unset = 6 hours, 0 disables the sweep.
# MONEY_RECONCILIATION_INTERVAL_MS=21600000

# QUALITY-2026-07-12 WS5 — Microsoft Presidio PII redaction for training assets
# (ai/privacy/presidio-adapter.ts). Two standard Presidio REST services: the
# Analyzer detects PII spans, the Anonymizer replaces them. Set BOTH to enable
# the Presidio-first redaction pass ahead of the deterministic scrub. When set,
# an unreachable/erroring backend FAILS CLOSED — the training asset is
# quarantined (reason: presidio_unavailable), never persisted with raw or
# regex-only text as active. Unset ⇒ local deterministic scrub only.
# PRESIDIO_ANALYZER_URL=http://presidio-analyzer:3000
# PRESIDIO_ANONYMIZER_URL=http://presidio-anonymizer:3000

# U7 — pre-signup "hear it answer" demo call (packages/api/src/demo/config.ts).
# Kill switch, default off (1/true/on/yes turns it on). Off: no demo call can
# start, and scripts/seed-demo-tenants.ts refuses to run in production.
# DEMO_CALLS_ENABLED=false
# The numbers below are read once at boot. A missing value takes the default
# shown; a malformed, zero, negative or fractional value (or a per-call
# estimate above the daily cost cap) closes ONLY the demo call, with one error
# log, and the rest of the app boots normally. Caps are integer counts and
# integer cents per UTC day; a changed cap applies from the next UTC day.
# DEMO_CALLS_DAILY_CAP=50
# DEMO_COST_DAILY_CAP_CENTS=2500
# DEMO_CALL_EST_COST_CENTS=50
# Demo tenants seeded per trade by scripts/seed-demo-tenants.ts.
# DEMO_POOL_PER_TRADE=3
# How long a demo call's status callback can still bind (hours).
# DEMO_STATUS_TOKEN_TTL_HOURS=24
# Rows per delete batch, and seconds to wait on in-flight jobs, when a demo
# tenant is reset after a call.
# DEMO_RESET_BATCH_ROWS=1000
# DEMO_RESET_DRAIN_SECONDS=90
# The demo call's own phone account and caller number (E.164), read per
# request by integrations/credentials.ts#getPlatformTwilioCreds. Never the
# global TWILIO_* account or a tenant's: any one unset or blank keeps the demo
# call off (503 DEMO_DISABLED, nothing written) even with the switch on.
# PLATFORM_TWILIO_ACCOUNT_SID=
# PLATFORM_TWILIO_AUTH_TOKEN=
# PLATFORM_TWILIO_FROM_NUMBER=
# HMAC secret for the demo call's callback token; it also keys the visitor's
# phone hash, so rotating it starts every visitor's daily allowance afresh.
# Required in production and staging (unset keeps the demo call off); dev
# falls back to a fixed secret. Generate: openssl rand -hex 32.
# DEMO_LEASE_TOKEN_SECRET=

# ═══ WEB SERVICE — BUILD-TIME (set on the @serviceos/web Railway service) ═══
VITE_API_URL=https://api.yourdomain.com
# Same Production publishable key as CLERK_PUBLISHABLE_KEY (pk_live_…).
# Also injected at container start into /env.js (packages/web/start.sh).
# Do NOT set VITE_AUTH_MODE=dev on this service.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
# Must be true in prod — drives the onboarding shell that hosts the billing step.
VITE_ONBOARDING_V2_ENABLED=true
